# ─────────────────────────────────────────────
# Nexorux HR — Environment Variables Template
# Copy this file to .env and fill in all values
# NEVER commit your real .env to version control
# ─────────────────────────────────────────────

# App
NODE_ENV=development       # development | production | test
PORT=5000

# Security (generate strong random strings for production)
JWT_SECRET=
CSRF_SECRET=

# Database
DATABASE_PATH=./data/nexorux_hr.db
LOG_LEVEL=info             # debug | info | warn | error

# AI / Groq
GROQ_API_KEY=              # Get your key at https://console.groq.com

# Seeding (set to 'false' in production)
SEED_DATABASE=true
