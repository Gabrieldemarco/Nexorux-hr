# Database
DATABASE_URL="postgresql://user:password@localhost:5432/terabox_viewer"

# TeraBox Authentication
# Get the ndus cookie from TeraBox:
# 1. Log in to https://www.terabox.com
# 2. Open browser DevTools (F12)
# 3. Go to Application > Cookies > https://www.terabox.com
# 4. Find the 'ndus' cookie and copy its value
# 5. Paste the value here (without 'ndus=' prefix, or with it)
TERABOX_NDUS="your_ndus_cookie_value_here"

# Better Auth Configuration
# Optional: Set the base URL for authentication
# In development, defaults to http://localhost:3000
# In production, set to your domain
BETTER_AUTH_URL="http://localhost:3000"

# Vercel Configuration (optional, for Vercel deployment)
# VERCEL_URL="your-vercel-url"
# VERCEL_PROJECT_PRODUCTION_URL="your-production-domain"

# V0 Runtime Configuration (optional, for v0.dev)
# V0_RUNTIME_URL="your-v0-runtime-url"
# V0_DEV_APP_URL="your-v0-dev-app-url"
# V0_BUILD_URL="your-v0-build-url"
# V0_SANDBOX_URL="your-v0-sandbox-url"
